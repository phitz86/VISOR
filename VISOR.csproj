<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>14.0</LangVersion>
    <RootNamespace>VISOR</RootNamespace>
    <ApplicationIcon>VISOR Logo.ico</ApplicationIcon>
    <AssemblyVersion>1.2.1.0</AssemblyVersion>
    <FileVersion>1.2.1.0</FileVersion>
    <Version>1.2.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Tests\**" />
    <None Remove="Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SVappsLAB.iRacingTelemetrySDK" Version="2.5.0" />
    <!-- Also comes with the SDK; referenced directly because SessionInfoYaml uses it to read
         session info the SDK can't. Keep it at the SDK's version. -->
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\Fonts\digital-7.ttf" />
    <Resource Include="Resources\Fonts\symbola-gear.ttf" />
    <Resource Include="VISOR Logo.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ships beside the exe (not embedded) so users can tune section boundaries
         and add tracks without a rebuild. -->
    <None Update="Data\TrackSections.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
