<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>14.0</LangVersion>
    <RootNamespace>VISOR</RootNamespace>
    <ApplicationIcon>VISOR Logo.ico</ApplicationIcon>
    <AssemblyVersion>1.2.0.0</AssemblyVersion>
    <FileVersion>1.2.0.0</FileVersion>
    <Version>1.2.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Archive\**" />
    <Compile Remove="Raw outputs\**" />
    <EmbeddedResource Remove="Archive\**" />
    <EmbeddedResource Remove="Raw outputs\**" />
    <None Remove="Archive\**" />
    <None Remove="Raw outputs\**" />
    <Page Remove="Archive\**" />
    <Page Remove="Raw outputs\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SVappsLAB.iRacingTelemetrySDK" Version="2.5.0" />
    <PackageReference Include="System.Management" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\Fonts\digital-7.ttf" />
    <Resource Include="VISOR Logo.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ships beside the exe (not embedded) so users can tune section boundaries
         and add tracks without a rebuild. -->
    <None Update="Data\TrackSections.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
