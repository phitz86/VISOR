<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows8.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <RootNamespace>VISOR</RootNamespace>
    <ApplicationIcon>VISOR Logo.ico</ApplicationIcon>
    <AssemblyVersion>0.9.8.3</AssemblyVersion>
    <FileVersion>0.9.8.3</FileVersion>
    <Version>0.9.8.3</Version>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Archive\**" />
    <Compile Remove="Raw outputs\**" />
    <EmbeddedResource Remove="Archive\**" />
    <EmbeddedResource Remove="Raw outputs\**" />
    <None Remove="Archive\**" />
    <None Remove="Raw outputs\**" />
    <Page Remove="Archive\**" />
    <Page Remove="Raw outputs\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="10.0.5" />
    <PackageReference Include="SVappsLAB.iRacingTelemetrySDK" Version="0.9.8.3" />
    <PackageReference Include="System.Management" Version="10.0.5" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\Fonts\digital-7.ttf" />
    <Resource Include="VISOR Logo.ico" />
  </ItemGroup>

</Project>
