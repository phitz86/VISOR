<Window x:Class="VISOR.Views.ConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VISOR Configuration" Height="880" Width="500"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontWeight="Semibold" FontFamily="Segoe UI" FontSize="14"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <StackPanel>
            <TextBlock Text="VISOR Configuration" FontWeight="Bold" FontSize="18" Margin="0,0,0,15" HorizontalAlignment="Center"/>

            <TextBlock Text="Configure which overlay elements to display:" Margin="0,0,0,15" TextWrapping="Wrap"/>

            <GroupBox Header="Window Size" Margin="0,0,0,15">
                <StackPanel Margin="10">
                    <TextBlock Text="Choose size preset for all windows:" Margin="0,0,0,8" TextWrapping="Wrap"/>
                    <ComboBox x:Name="WindowSizeCombo" SelectedIndex="2" SelectionChanged="WindowSizeCombo_SelectionChanged">
                        <ComboBoxItem Content="Small (60% scale)" Tag="Small"/>
                        <ComboBoxItem Content="Medium (80% scale)" Tag="Medium"/>
                        <ComboBoxItem Content="Large (100% scale)" Tag="Large"/>
                    </ComboBox>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Display Elements" Margin="0,0,0,15">
                <StackPanel Margin="10">
                    <CheckBox x:Name="Row0CheckBox" Content="Row 0: Gear Indicator + Position"
                              IsChecked="True" Margin="0,0,0,8" Checked="RowCheckBox_Changed" Unchecked="RowCheckBox_Changed"/>
                    <StackPanel Orientation="Horizontal" Margin="20,0,0,8">
                        <TextBlock Text="Position Display:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <RadioButton x:Name="PositionClassRadio" Content="Class" GroupName="PositionDisplay"
                                     VerticalAlignment="Center" Margin="0,0,12,0"
                                     Checked="PositionDisplayRadio_Changed"/>
                        <RadioButton x:Name="PositionOverallRadio" Content="Overall" GroupName="PositionDisplay"
                                     VerticalAlignment="Center"
                                     Checked="PositionDisplayRadio_Changed"/>
                    </StackPanel>
                    <CheckBox x:Name="Row1CheckBox" Content="Row 1: Time Remaining + Fuel Remaining"
                              IsChecked="True" Margin="0,0,0,8" Checked="RowCheckBox_Changed" Unchecked="RowCheckBox_Changed"/>
                    <CheckBox x:Name="Row2CheckBox" Content="Row 2: Lap Delta Bar" 
                              IsChecked="True" Margin="0,0,0,8" Checked="RowCheckBox_Changed" Unchecked="RowCheckBox_Changed"/>
                    <CheckBox x:Name="Row3CheckBox" Content="Row 3: Last Lap Time + Best Lap Time" 
                              IsChecked="True" Margin="0,0,0,8" Checked="RowCheckBox_Changed" Unchecked="RowCheckBox_Changed"/>
                    <CheckBox x:Name="Row4CheckBox" Content="Row 4: Relative Positioning Table"
                              IsChecked="True" Margin="0,0,0,8" Checked="RowCheckBox_Changed" Unchecked="RowCheckBox_Changed"/>
                    <CheckBox x:Name="HidePitsCheckBox" Content="Hide cars in the pits"
                              IsChecked="False" Margin="20,0,0,8"
                              IsEnabled="{Binding IsChecked, ElementName=Row4CheckBox}"
                              Checked="HidePitsCheckBox_Changed" Unchecked="HidePitsCheckBox_Changed"/>
                    <CheckBox x:Name="Row5CheckBox" Content="Row 5: Warnings (Incidents, Pace, Pit Cue)"
                              IsChecked="True" Margin="0,0,0,8" Checked="RowCheckBox_Changed" Unchecked="RowCheckBox_Changed"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Radar Window" Margin="0,0,0,15">
                <StackPanel Margin="10">
                    <CheckBox x:Name="RadarCheckBox" Content="Show Radar Window"
                              IsChecked="True" Margin="0,0,0,8" Checked="RadarCheckBox_Changed" Unchecked="RadarCheckBox_Changed"/>
                    <TextBlock Text="Displays nearby cars and spotter information"
                               FontStyle="Italic" Foreground="Gray" FontSize="11" TextWrapping="Wrap"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Debug Settings (for Beta Testing)" Margin="0,0,0,15">
                <StackPanel Margin="10">
                    <CheckBox x:Name="DebugModeCheckBox"
                             Content="Enable Debug Mode (Verbose Logging)"
                             Margin="0,0,0,8"
                             Checked="DebugModeCheckBox_Checked"
                             Unchecked="DebugModeCheckBox_Unchecked"/>

                    <TextBlock Text="When enabled, detailed logs will be saved to the Logs folder."
                              FontStyle="Italic" Foreground="Gray" FontSize="11"
                              TextWrapping="Wrap" Margin="0,0,0,8"/>

                    <Button x:Name="OpenLogsFolderButton" Content="Open Logs Folder"
                           Width="130" Height="25" HorizontalAlignment="Left" Margin="0,0,0,8"
                           Click="OpenLogsFolderButton_Click"/>

                    <TextBlock x:Name="CurrentLogFileText" FontSize="10" Foreground="Gray"
                              TextWrapping="Wrap"/>
                </StackPanel>
            </GroupBox>

            <Border Background="#FFF3CD" BorderBrush="#FFEAA7" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="⚠️ Important:" FontWeight="Bold" Foreground="#856404" HorizontalAlignment="Center"/>
                    <TextBlock TextWrapping="Wrap" Foreground="#856404" FontSize="11">
                        VISOR will only display over iRacing if the simulator is running in borderless windowed mode.
                    </TextBlock>
                </StackPanel>
            </Border>

            <TextBlock Text="Changes are applied in real-time to preview windows. Drag windows to reposition them."
                       FontStyle="Italic" Foreground="Gray" FontSize="11" TextAlignment="Center" Margin="0,0,0,15" TextWrapping="Wrap"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Done" Click="DoneButton_Click" Width="80" Margin="0,0,10,0" IsDefault="True"/>
                <Button Content="Exit VISOR" Click="ExitButton_Click" Width="80"/>
            </StackPanel>

        </StackPanel>

        <!-- Version display in bottom-right corner -->
        <TextBlock x:Name="VersionText"
                   HorizontalAlignment="Right" 
                   VerticalAlignment="Bottom"
                   Margin="0,0,15,10"
                   FontSize="10"
                   Foreground="Gray"
                   Text="Version 1.0.0"/>
    </Grid>
</Window>