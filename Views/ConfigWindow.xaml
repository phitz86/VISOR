<Window x:Class="VISOR.Views.ConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VISOR Configuration" Height="760" Width="540"
        MinHeight="480" MinWidth="460"
        Background="#F3F3F3"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>

        <!-- ============ Palette ============ -->
        <Color x:Key="AccentColor">#FF0067C0</Color>
        <SolidColorBrush x:Key="Accent" Color="#FF0067C0"/>
        <SolidColorBrush x:Key="AccentHover" Color="#FF1A75C5"/>
        <SolidColorBrush x:Key="AccentPressed" Color="#FF005BA1"/>
        <SolidColorBrush x:Key="Surface" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="CardBorder" Color="#FFE3E3E3"/>
        <SolidColorBrush x:Key="ControlBorder" Color="#FFCFCFCF"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FF1B1B1B"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#FF646464"/>
        <SolidColorBrush x:Key="HoverFill" Color="#FFF0F0F0"/>

        <!-- ============ Typography ============ -->
        <Style x:Key="TitleText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        </Style>

        <Style x:Key="SubtitleText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- ============ Card container (replaces GroupBox) ============ -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <!-- ============ Modern CheckBox ============ -->
        <Style TargetType="CheckBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box" Width="20" Height="20" CornerRadius="4"
                                    Background="{StaticResource Surface}"
                                    BorderBrush="{StaticResource ControlBorder}" BorderThickness="1.5"
                                    VerticalAlignment="Center">
                                <Path x:Name="Check" Width="12" Height="12" Stretch="Uniform"
                                      Data="M0,5 L4,9 L11,1" Stroke="White" StrokeThickness="2"
                                      StrokeEndLineCap="Round" StrokeStartLineCap="Round"
                                      Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Modern RadioButton ============ -->
        <Style TargetType="RadioButton">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Grid Width="20" Height="20" VerticalAlignment="Center">
                                <Ellipse x:Name="Ring" Stroke="{StaticResource ControlBorder}" StrokeThickness="1.5"
                                         Fill="{StaticResource Surface}"/>
                                <Ellipse x:Name="Dot" Width="9" Height="9" Fill="White" Visibility="Collapsed"/>
                            </Grid>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Fill" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource Accent}"/>
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Modern ComboBox ============ -->
        <ControlTemplate x:Key="ComboToggle" TargetType="ToggleButton">
            <Border x:Name="Bd" CornerRadius="5" Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource ControlBorder}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="30"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Data="M0,0 L4,4 L8,0" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.5"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="ComboBox">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Template="{StaticResource ComboToggle}"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter x:Name="ContentSite"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="12,0,30,0"
                                              VerticalAlignment="Center" HorizontalAlignment="Left"
                                              IsHitTestVisible="False"/>
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border Margin="0,4,0,0" Background="{StaticResource Surface}"
                                        BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                                        CornerRadius="6" MinWidth="{TemplateBinding ActualWidth}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.18" Color="Black"/>
                                    </Border.Effect>
                                    <ScrollViewer>
                                        <StackPanel IsItemsHost="True" Margin="4"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" CornerRadius="4" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverFill}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFE6F1FB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Buttons ============ -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentPressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                BorderBrush="{StaticResource ControlBorder}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverFill}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFE8E8E8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Header (fixed) | Scrollable content | Footer (fixed) -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============ Header ============ -->
        <StackPanel Grid.Row="0" Margin="24,22,24,12">
            <TextBlock Text="VISOR Configuration" Style="{StaticResource TitleText}"/>
            <TextBlock Text="Configure which overlay elements to display. Changes apply in real time."
                       Style="{StaticResource SubtitleText}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- ============ Scrollable content ============ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      Padding="24,4,24,4" CanContentScroll="False">
            <StackPanel>

                <!-- Important notice -->
                <Border Background="#FFFFF8E6" BorderBrush="#FFF2D98A" BorderThickness="1"
                        CornerRadius="8" Padding="16,12" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#x26A0;" FontSize="18" Foreground="#FFB8860B"
                                   VerticalAlignment="Top" Margin="0,1,12,0"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Important" FontFamily="Segoe UI Semibold" FontSize="13"
                                       Foreground="#FF7A5C00" Margin="0,0,0,2"/>
                            <TextBlock Text="VISOR will only display over iRacing if the simulator is running in borderless windowed mode."
                                       FontSize="12" Foreground="#FF7A5C00" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Window Size -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Window Size" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Text="Choose a size preset for all windows:" Style="{StaticResource HintText}" Margin="0,0,0,8"/>
                        <ComboBox x:Name="WindowSizeCombo" SelectedIndex="2" SelectionChanged="WindowSizeCombo_SelectionChanged">
                            <ComboBoxItem Content="Small (60% scale)" Tag="Small"/>
                            <ComboBoxItem Content="Medium (80% scale)" Tag="Medium"/>
                            <ComboBoxItem Content="Large (100% scale)" Tag="Large"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- Display Elements -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Display Elements" Style="{StaticResource SectionHeader}"/>
                        <CheckBox x:Name="Row0CheckBox" Content="Row 0: Gear Indicator + Position"
                                  IsChecked="True" Checked="RowCheckBox_Changed" Unchecked="RowCheckBox_Changed"/>
                        <StackPanel Orientation="Horizontal" Margin="30,0,0,10">
                            <TextBlock Text="Position Display:" VerticalAlignment="Center" Margin="0,0,12,0"
                                       Foreground="{StaticResource TextSecondary}" FontSize="13"/>
                            <RadioButton x:Name="PositionClassRadio" Content="Class" GroupName="PositionDisplay"
                                         VerticalAlignment="Center" Margin="0,0,16,0"
                                         Checked="PositionDisplayRadio_Changed"/>
                            <RadioButton x:Name="PositionOverallRadio" Content="Overall" GroupName="PositionDisplay"
                                         VerticalAlignment="Center"
                                         Checked="PositionDisplayRadio_Changed"/>
                        </StackPanel>
                        <CheckBox x:Name="Row1CheckBox" Content="Row 1: Time Remaining + Fuel Remaining"
                                  IsChecked="True" Checked="RowCheckBox_Changed" Unchecked="RowCheckBox_Changed"/>
                        <CheckBox x:Name="Row2CheckBox" Content="Row 2: Lap Delta Bar"
                                  IsChecked="True" Checked="RowCheckBox_Changed" Unchecked="RowCheckBox_Changed"/>
                        <CheckBox x:Name="Row3CheckBox" Content="Row 3: Last Lap Time + Best Lap Time"
                                  IsChecked="True" Checked="RowCheckBox_Changed" Unchecked="RowCheckBox_Changed"/>
                        <CheckBox x:Name="Row4CheckBox" Content="Row 4: Relative Positioning Table"
                                  IsChecked="True" Checked="RowCheckBox_Changed" Unchecked="RowCheckBox_Changed"/>
                        <CheckBox x:Name="HidePitsCheckBox" Content="Hide cars in the pits"
                                  IsChecked="False" Margin="30,0,0,10"
                                  IsEnabled="{Binding IsChecked, ElementName=Row4CheckBox}"
                                  Checked="HidePitsCheckBox_Changed" Unchecked="HidePitsCheckBox_Changed"/>
                        <CheckBox x:Name="Row5CheckBox" Content="Row 5: Warnings (Incidents, Pace, Pit Cue)"
                                  IsChecked="True" Margin="0" Checked="RowCheckBox_Changed" Unchecked="RowCheckBox_Changed"/>
                    </StackPanel>
                </Border>

                <!-- Radar Window -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Radar Window" Style="{StaticResource SectionHeader}"/>
                        <CheckBox x:Name="RadarCheckBox" Content="Show Radar Window"
                                  IsChecked="True" Margin="0,0,0,8" Checked="RadarCheckBox_Changed" Unchecked="RadarCheckBox_Changed"/>
                        <TextBlock Text="Displays nearby cars and spotter information." Style="{StaticResource HintText}"/>
                    </StackPanel>
                </Border>

                <!-- Debug Settings -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Debug Settings (for Beta Testing)" Style="{StaticResource SectionHeader}"/>
                        <CheckBox x:Name="DebugModeCheckBox" Content="Enable Debug Mode (Verbose Logging)"
                                  Checked="DebugModeCheckBox_Checked" Unchecked="DebugModeCheckBox_Unchecked"/>
                        <TextBlock Text="When enabled, detailed logs will be saved to the Logs folder."
                                   Style="{StaticResource HintText}" Margin="0,0,0,12"/>
                        <Button x:Name="OpenLogsFolderButton" Content="Open Logs Folder"
                                Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                                Margin="0,0,0,10" Click="OpenLogsFolderButton_Click"/>
                        <TextBlock x:Name="CurrentLogFileText" FontSize="11"
                                   Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="Drag windows to reposition them. Positions are saved when you click Done."
                           Style="{StaticResource HintText}" TextAlignment="Center" Margin="0,0,0,4"/>
            </StackPanel>
        </ScrollViewer>

        <!-- ============ Footer (fixed) ============ -->
        <Border Grid.Row="2" Background="#FFFAFAFA" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0">
            <Grid Margin="24,14">
                <TextBlock x:Name="VersionText" VerticalAlignment="Center" HorizontalAlignment="Left"
                           FontSize="11" Foreground="{StaticResource TextSecondary}" Text="Version 1.0.0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Done" Click="DoneButton_Click" IsDefault="True"
                            Style="{StaticResource PrimaryButton}" Margin="0,0,10,0"/>
                    <Button Content="Exit VISOR" Click="ExitButton_Click"
                            Style="{StaticResource SecondaryButton}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
