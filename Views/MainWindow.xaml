<Window x:Class="VISOR.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:VISOR.Resources.Converters"
        xmlns:viewModels="clr-namespace:VISOR.ViewModels"
        Title="VISOR"
        Icon="/VISOR Logo.ico"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="NoResize">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <viewModels:DeltaBarWidthConverter x:Key="DeltaBarWidthConverter"/>
            <converters:ProximityToWidthConverter x:Key="ProximityToWidthConverter"/>

            <Style x:Key="BaseTextBlock" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI"/>
            </Style>

            <Style x:Key="SemiboldText" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlock}">
                <Setter Property="FontWeight" Value="Semibold"/>
                <Setter Property="Foreground" Value="White"/>
            </Style>

            <Style x:Key="NormalWeightSymbol" TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlock}">
                <Setter Property="FontWeight" Value="Normal"/>
            </Style>

            <Style x:Key="DigitalIndicator" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="pack://application:,,,/Resources/Fonts/#Digital-7"/>
                <Setter Property="FontWeight" Value="Normal"/>
                <Setter Property="Foreground" Value="White"/>
            </Style>

        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Border x:Name="MainContentContainer" 
                Panel.ZIndex="0"
                CornerRadius="12" 
                Margin="10" 
                Background="#A0202020" 
                ClipToBounds="True">
            <Grid>
                <Grid.LayoutTransform>
                    <ScaleTransform ScaleX="{Binding ScaleFactor}" ScaleY="{Binding ScaleFactor}"/>
                </Grid.LayoutTransform>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0"
                            Orientation="Horizontal"
                            Visibility="{Binding ShowGear, Converter={StaticResource BoolToVisibilityConverter}}"
                            HorizontalAlignment="Center">
                    <TextBlock Text="⚙" FontSize="54" Foreground="LightGray" VerticalAlignment="Bottom" Margin="0,0,8,0" Style="{StaticResource NormalWeightSymbol}"/>
                    <TextBlock Text="{Binding GearDisplay}" FontSize="80" VerticalAlignment="Bottom" Style="{StaticResource DigitalIndicator}"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" 
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding ShowPosition, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="P" FontSize="60" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource NormalWeightSymbol}" FontWeight="Bold"/>
                    <TextBlock Text="{Binding ClassPositionNumber}" FontSize="72" VerticalAlignment="Center" Style="{StaticResource DigitalIndicator}"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal"
                            Visibility="{Binding ShowTimeRemaining, Converter={StaticResource BoolToVisibilityConverter}}"
                            HorizontalAlignment="Center">
                    <TextBlock Text="{Binding CountdownVM.TimeRemainingSymbol}" FontSize="36" Margin="0,0,8,0" Style="{StaticResource NormalWeightSymbol}" Foreground="White"/>
                    <TextBlock Text="{Binding CountdownVM.TimeRemainingDisplay}" FontSize="36" Style="{StaticResource SemiboldText}"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal"
                            Visibility="{Binding ShowFuelRemaining, Converter={StaticResource BoolToVisibilityConverter}}"
                            HorizontalAlignment="Center">
                    <TextBlock Text="⛽" FontSize="36" Margin="0,0,8,0" Foreground="Red" Style="{StaticResource NormalWeightSymbol}"/>
                    <TextBlock Text="{Binding FuelVM.FuelDisplay}" FontSize="36" Style="{StaticResource SemiboldText}"/>
                </StackPanel>

                <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Height="12" Background="#333333"
                        Visibility="{Binding ShowLapDelta, Converter={StaticResource BoolToVisibilityConverter}}"
                        Margin="0,10,0,0" CornerRadius="6">
                    <Grid Name="DeltaBarContainer">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Rectangle Grid.Column="0" 
                                   Fill="{Binding DeltaBarVM.LeftBarColor}"
                                   HorizontalAlignment="Right">
                            <Rectangle.Width>
                                <MultiBinding Converter="{StaticResource DeltaBarWidthConverter}">
                                    <Binding Path="DeltaBarVM.LeftBarWidth"/>
                                    <Binding Path="ActualWidth" ElementName="DeltaBarContainer"/>
                                </MultiBinding>
                            </Rectangle.Width>
                        </Rectangle>
                        <Rectangle Grid.Column="1" 
                                   Fill="{Binding DeltaBarVM.RightBarColor}"
                                   HorizontalAlignment="Left">
                            <Rectangle.Width>
                                <MultiBinding Converter="{StaticResource DeltaBarWidthConverter}">
                                    <Binding Path="DeltaBarVM.RightBarWidth"/>
                                    <Binding Path="ActualWidth" ElementName="DeltaBarContainer"/>
                                </MultiBinding>
                            </Rectangle.Width>
                        </Rectangle>
                        <Rectangle Grid.ColumnSpan="2" Width="2" Fill="White" HorizontalAlignment="Center"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="3" Grid.Column="0" Orientation="Horizontal"
                            Visibility="{Binding ShowLapTimes, Converter={StaticResource BoolToVisibilityConverter}}"
                            HorizontalAlignment="Center">
                    <TextBlock Text="⏱" FontSize="30" Margin="0,0,8,0" Foreground="White" Style="{StaticResource NormalWeightSymbol}"/>
                    <TextBlock Text="{Binding LastLapTime}" FontSize="30" Style="{StaticResource SemiboldText}"/>
                </StackPanel>

                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal"
                            Visibility="{Binding ShowLapTimes, Converter={StaticResource BoolToVisibilityConverter}}"
                            HorizontalAlignment="Center">
                    <TextBlock Text="🏆" FontSize="30" Foreground="DarkGoldenrod" Margin="0,0,8,0" Style="{StaticResource NormalWeightSymbol}"/>
                    <TextBlock Text="{Binding BestLapTime}" FontSize="30" Style="{StaticResource SemiboldText}"/>
                </StackPanel>

                <ItemsControl Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                              ItemsSource="{Binding RelativeVM.RelativeRows}"
                              Visibility="{Binding ShowRelative, Converter={StaticResource BoolToVisibilityConverter}}"
                              Margin="0,10,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{Binding ClassPos}" Grid.Column="0" FontSize="24" HorizontalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource SemiboldText}"/>

                                <Border Grid.Column="1" Background="{Binding ClassBackground}" Padding="4" CornerRadius="3" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding CarNum}" FontSize="24" HorizontalAlignment="Center" FontWeight="Bold" FontFamily="Segoe UI"/>
                                </Border>

                                <Grid Grid.Column="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Text="{Binding Name}" 
                                               FontSize="24" 
                                               Foreground="{Binding NameColor}" 
                                               FontStyle="{Binding FontStyle}" 
                                               Margin="8,0,20,2"
                                               Style="{StaticResource SemiboldText}"/>

                                    <!-- 5-Segment Proximity Indicator as Underline -->
                                    <Grid Grid.Row="1" Margin="8,0,8,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="2"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="2"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="2"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="2"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Background="{Binding Segment1Color}" 
                                                Height="8" 
                                                CornerRadius="2" 
                                                Opacity="0.8"/>
                                        <Border Grid.Column="2"
                                                Background="{Binding Segment2Color}" 
                                                Height="8" 
                                                CornerRadius="2" 
                                                Opacity="0.8"/>
                                        <Border Grid.Column="4"
                                                Background="{Binding Segment3Color}" 
                                                Height="8" 
                                                CornerRadius="2" 
                                                Opacity="0.8"/>
                                        <Border Grid.Column="6"
                                                Background="{Binding Segment4Color}" 
                                                Height="8" 
                                                CornerRadius="2" 
                                                Opacity="0.8"/>
                                        <Border Grid.Column="8"
                                                Background="{Binding Segment5Color}" 
                                                Height="8" 
                                                CornerRadius="2" 
                                                Opacity="0.8"/>
                                    </Grid>
                                </Grid>

                                <!-- Gap Display Column -->
                                <TextBlock Grid.Column="3"
                                           Text="{Binding GapText}"
                                           FontSize="24"
                                           Foreground="{Binding GapColor}"
                                           FontWeight="{Binding GapFontWeight}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Margin="8,0,8,0"
                                           Style="{StaticResource SemiboldText}"/>

                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2"
                      Visibility="{Binding ShowWarnings, Converter={StaticResource BoolToVisibilityConverter}}"
                      Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="⚠️" FontSize="36" Margin="0,0,10,0" Foreground="{Binding WarningsVM.IncidentColor}" Style="{StaticResource NormalWeightSymbol}"/>
                        <TextBlock Text="{Binding WarningsVM.IncidentDisplay}" FontSize="36" Foreground="{Binding WarningsVM.IncidentColor}" Style="{StaticResource SemiboldText}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="📉" FontSize="36" Foreground="Red"
                                   Visibility="{Binding WarningsVM.IsPaceWarningVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                   Style="{StaticResource NormalWeightSymbol}"/>
                        <TextBlock Text="•" FontSize="36" Foreground="Red" Margin="5,0,0,0"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding WarningsVM.IsPersistentDotVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                   Style="{StaticResource NormalWeightSymbol}"/>
                        <TextBlock Text="{Binding WarningsVM.PitNowText}" FontSize="36" FontWeight="Bold" Foreground="Yellow" Margin="15,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WarningsVM.IsPitNowVisible}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                         From="1.0" To="0.2" Duration="0:0:0.5"
                                                                         AutoReverse="True" RepeatBehavior="Forever"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="StatusText" Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Text="Status..." Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,10,0,10" Visibility="Collapsed"/>
            </Grid>
        </Border>

        <Border x:Name="DragHandle"
                Panel.ZIndex="100"
                CornerRadius="4" 
                Width="48" Height="48"
                BorderBrush="#808080" 
                BorderThickness="1"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="20,20,0,0"
                Cursor="SizeAll"
                Visibility="Collapsed"
                MouseLeftButtonDown="DragHandle_MouseLeftButtonDown">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#80404040"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#80606060"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <TextBlock Text="⬉" FontSize="16" FontWeight="Bold"
                           HorizontalAlignment="Left" VerticalAlignment="Top" 
                           Margin="6,6,0,0" Foreground="White"/>
                <TextBlock Text="⬈" FontSize="16" FontWeight="Bold"
                           HorizontalAlignment="Right" VerticalAlignment="Top" 
                           Margin="0,6,6,0" Foreground="White"/>
                <TextBlock Text="⬋" FontSize="16" FontWeight="Bold"
                           HorizontalAlignment="Left" VerticalAlignment="Bottom" 
                           Margin="6,0,0,6" Foreground="White"/>
                <TextBlock Text="⬊" FontSize="16" FontWeight="Bold"
                           HorizontalAlignment="Right" VerticalAlignment="Bottom" 
                           Margin="0,0,6,6" Foreground="White"/>
            </Grid>
        </Border>

        <Button x:Name="ConfigButton"
                Panel.ZIndex="100"
                Content="⚙"
                Width="24" Height="24"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,18,46,0"
                Foreground="White"
                BorderThickness="0"
                FontSize="16"
                Cursor="Hand"
                Click="ConfigButton_Click">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Background" Value="#80808080"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="3">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#800080FF"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Background" Value="#FF0080FF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>
        </Button>

        <Button x:Name="ExitButton"
                Panel.ZIndex="100"
                Content="✕"
                Width="24" Height="24"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,18,18,0"
                Foreground="White"
                BorderThickness="0"
                FontSize="14" FontWeight="Bold"
                Cursor="Hand"
                Click="ExitButton_Click">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Background" Value="#80808080"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" 
                                        CornerRadius="3">
                                    <ContentPresenter HorizontalAlignment="Center" 
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#CCFF0000"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Background" Value="#FFFF0000"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>
        </Button>
    </Grid>
</Window>