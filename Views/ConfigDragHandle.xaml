<UserControl x:Class="VISOR.Views.ConfigDragHandle"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="48" Height="48"
             Cursor="SizeAll"
             Visibility="Collapsed">
    <!-- Shown only in config mode; drag it to move its window (ConfigDragHandle.xaml.cs). -->
    <Border CornerRadius="4"
            BorderBrush="#808080"
            BorderThickness="1">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="#80404040"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#80606060"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <TextBlock Text="⬉" FontSize="16" FontWeight="Bold"
                       HorizontalAlignment="Left" VerticalAlignment="Top"
                       Margin="6,6,0,0" Foreground="White"/>
            <TextBlock Text="⬈" FontSize="16" FontWeight="Bold"
                       HorizontalAlignment="Right" VerticalAlignment="Top"
                       Margin="0,6,6,0" Foreground="White"/>
            <TextBlock Text="⬋" FontSize="16" FontWeight="Bold"
                       HorizontalAlignment="Left" VerticalAlignment="Bottom"
                       Margin="6,0,0,6" Foreground="White"/>
            <TextBlock Text="⬊" FontSize="16" FontWeight="Bold"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom"
                       Margin="0,0,6,6" Foreground="White"/>
        </Grid>
    </Border>
</UserControl>
