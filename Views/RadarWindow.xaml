<Window x:Class="VISOR.Views.RadarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VISOR Radar"
        Icon="/VISOR Logo.ico"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#A0202020"
        Topmost="True"
        ResizeMode="NoResize"
        Width="300" Height="300">

	<Grid>
		<!-- Radar Canvas -->
		<Canvas x:Name="RadarCanvas"
                Width="280" Height="280"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                ClipToBounds="True">

			<!-- Container for other cars (canvas positioning) -->
			<Canvas x:Name="CarsContainer"/>

		</Canvas>

		<!-- Background circle (centered) -->
		<Ellipse Width="280" Height="280"
                 Stroke="#333333" StrokeThickness="1"
                 Fill="Transparent"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"/>

		<!-- Outer ring (4 car lengths) - centered -->
		<Ellipse Width="224" Height="224"
                 Stroke="#555555" StrokeThickness="1"
                 Fill="Transparent"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"/>

		<!-- Inner ring (2 car lengths) - centered -->
		<Ellipse Width="112" Height="112"
                 Stroke="#555555" StrokeThickness="1"
                 Fill="Transparent"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"/>

		<!-- Crosshair - vertical line (centered) -->
		<Line X1="0" Y1="0" X2="0" Y2="280"
              Stroke="#777777" StrokeThickness="1"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"/>

		<!-- Crosshair - horizontal line (centered) -->
		<Line X1="0" Y1="0" X2="280" Y2="0"
              Stroke="#777777" StrokeThickness="1"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"/>

		<!-- Player car (green rectangle in center) -->
		<Rectangle x:Name="PlayerCar"
                   Width="12" Height="24"
                   Fill="Lime"
                   Stroke="DarkGreen" StrokeThickness="1"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>

		<!-- Debug info (remove in production) -->
		<TextBlock x:Name="DebugText"
                   Text="Radar: Waiting for data..."
                   Foreground="White" FontSize="10"
                   HorizontalAlignment="Left" VerticalAlignment="Bottom"
                   Margin="5"/>

	</Grid>
</Window>