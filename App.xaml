<Application x:Class="VISOR.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:VISOR">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/VISOR;component/Resources/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Global Style for Buttons -->
            <Style TargetType="Button">
                <Setter Property="Margin" Value="5"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Padding" Value="6,3"/>
            </Style>

            <!-- Global Style for CheckBoxes -->
            <Style TargetType="CheckBox">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
            </Style>

            <!-- Global Style for TextBlocks -->
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="FontSize" Value="14"/>
            </Style>

            <!-- Global Style for Window Backgrounds (Optional overlay styling) -->
            <Style TargetType="Window">
                <Setter Property="Background" Value="#FFEEEEEE"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>

</Application>
